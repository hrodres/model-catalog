<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<title>Model Catalog — OpenCode Zen · Go · OpenRouter</title>
<meta name="description" content="Catálogo de modelos OpenCode Zen/Go/OpenRouter: busca, compara precios, estado de salud y cuota de uso.">
<meta name="theme-color" content="#0b0d13">
<style>
  :root{
    --bg:#0b0d13; --bg-soft:#10131c; --card:#151926; --card-hover:#1a1f30;
    --border:#242a3d; --border-soft:#1d2231; --text:#e7e9f0; --muted:#9aa1b8;
    --accent:#6d9bff; --accent-soft:rgba(109,155,255,.12);
    --green:#34d399; --red:#f87171; --amber:#fbbf24;
    --go:#6d9bff; --zen:#a78bfa; --orange:#fb923c;
    --radius:14px; --radius-sm:10px; --shadow:0 8px 30px rgba(0,0,0,.35);
    --font:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,"Inter",sans-serif;
  }
  *{box-sizing:border-box;margin:0;padding:0}
  html{-webkit-text-size-adjust:100%}
  body{background:var(--bg);color:var(--text);font-family:var(--font);min-height:100vh;line-height:1.5}
  .wrap{max-width:1180px;margin:0 auto;padding:0 16px 90px}
  a{color:var(--accent);text-decoration:none}
  a:hover{text-decoration:underline}

  /* ── Sticky topbar ── */
  .topbar{position:sticky;top:0;z-index:60;background:rgba(11,13,19,.88);backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px);border-bottom:1px solid var(--border-soft)}
  .topbar-in{max-width:1180px;margin:0 auto;padding:11px 16px;display:flex;align-items:center;gap:12px;flex-wrap:wrap}
  .brand{display:flex;align-items:center;gap:10px;min-width:0}
  .logo{width:34px;height:34px;border-radius:10px;background:linear-gradient(135deg,var(--accent),var(--zen));display:flex;align-items:center;justify-content:center;font-size:17px;flex-shrink:0;box-shadow:0 4px 14px rgba(109,155,255,.35)}
  .brand h1{font-size:1.02rem;font-weight:700;letter-spacing:-.01em;white-space:nowrap}
  .brand .sub{font-size:.7rem;color:var(--muted)}
  .topbar-spacer{flex:1}
  .updated{font-size:.72rem;color:var(--muted);background:var(--card);border:1px solid var(--border-soft);padding:5px 11px;border-radius:999px;white-space:nowrap}
  .updated b{color:var(--text)}

  /* ── Top nav tabs (desktop) ── */
  .nav{max-width:1180px;margin:0 auto;display:flex;gap:4px;padding:10px 16px 0;overflow-x:auto;-webkit-overflow-scrolling:touch}
  .nav button{touch-action:manipulation;background:transparent;border:none;color:var(--muted);font-family:inherit;font-size:.86rem;font-weight:600;padding:9px 14px;border-radius:10px 10px 0 0;cursor:pointer;white-space:nowrap;border-bottom:2px solid transparent;transition:color .15s,border-color .15s,background .15s}
  .nav button:hover{color:var(--text);background:var(--card)}
  .nav button.active{color:var(--text);border-bottom-color:var(--accent);background:var(--card)}
  .nav button:focus-visible{outline:2px solid var(--accent);outline-offset:-2px}

  .panel{display:none;margin-top:14px}
  .panel.active{display:block;animation:fade .2s ease}
  @keyframes fade{from{opacity:0;transform:translateY(4px)}to{opacity:1;transform:none}}

  .section-title{font-size:1.04rem;font-weight:700;letter-spacing:-.01em;margin:6px 0 4px}
  .section-sub{font-size:.78rem;color:var(--muted);margin-bottom:14px}

  /* ── KPI cards (Resumen) ── */
  .kpi-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:12px;margin-bottom:18px}
  .kpi{background:var(--card);border:1px solid var(--border);border-radius:var(--radius);padding:16px;box-shadow:var(--shadow);position:relative;overflow:hidden}
  .kpi .kpi-top{display:flex;align-items:center;gap:8px;font-size:.72rem;color:var(--muted);text-transform:uppercase;letter-spacing:.05em;font-weight:700;margin-bottom:8px}
  .kpi .kpi-val{font-size:1.7rem;font-weight:800;letter-spacing:-.02em;line-height:1.1}
  .kpi .kpi-foot{font-size:.74rem;color:var(--muted);margin-top:6px}
  .sema{width:10px;height:10px;border-radius:50%;display:inline-block;flex-shrink:0}
  .sema.ok{background:var(--green);box-shadow:0 0 8px var(--green)}
  .sema.warn{background:var(--amber);box-shadow:0 0 8px var(--amber)}
  .sema.down{background:var(--red);box-shadow:0 0 8px var(--red)}

  /* ── Provider cards ── */
  .prov-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:12px;margin-bottom:18px}
  .prov{background:var(--card);border:1px solid var(--border);border-radius:var(--radius);padding:15px;box-shadow:var(--shadow);border-left:4px solid var(--border)}
  .prov.go{border-left-color:var(--go)}
  .prov.zen{border-left-color:var(--zen)}
  .prov.or{border-left-color:var(--orange)}
  .prov-head{display:flex;align-items:center;gap:9px;margin-bottom:10px}
  .prov-head .pname{font-weight:700;font-size:.98rem}
  .prov-head .ptag{font-size:.68rem;color:var(--muted);background:var(--bg-soft);border:1px solid var(--border-soft);padding:2px 8px;border-radius:999px}
  .prov-stats{display:flex;gap:14px;flex-wrap:wrap}
  .prov-stats div{font-size:.8rem;color:var(--muted)}
  .prov-stats b{color:var(--text);font-size:1.05rem;font-weight:700;display:block}
  .prov-note{font-size:.72rem;color:var(--muted);margin-top:9px;line-height:1.5}

  /* ── Legend / glossary ── */
  .legend{display:flex;gap:16px;flex-wrap:wrap;font-size:.74rem;color:var(--muted);margin:6px 0 4px}
  .legend span{display:inline-flex;align-items:center;gap:6px}
  details.gloss{background:var(--card);border:1px solid var(--border);border-radius:var(--radius);padding:4px 16px;margin-top:10px;box-shadow:var(--shadow)}
  details.gloss summary{cursor:pointer;padding:12px 0;font-weight:650;font-size:.9rem;list-style:none;display:flex;align-items:center;gap:8px}
  details.gloss summary::-webkit-details-marker{display:none}
  details.gloss summary::before{content:"📖";}
  details.gloss .g-body{padding:4px 0 14px}
  .g-item{display:flex;gap:12px;padding:8px 0;border-top:1px solid var(--border-soft);font-size:.84rem}
  .g-item:first-child{border-top:none}
  .g-item b{color:var(--accent);min-width:130px;display:inline-block;font-weight:700}
  .g-item span{color:var(--muted)}

  /* ── Tables ── */
  .table-card{background:var(--card);border:1px solid var(--border);border-radius:var(--radius);overflow:hidden;box-shadow:var(--shadow)}
  .table-scroll{overflow-x:auto}
  table{width:100%;border-collapse:collapse;font-size:.87rem;min-width:0}
  #tbl-cat{min-width:760px}
  #tbl-price{min-width:520px}
  table.health{min-width:520px}
  thead th{text-align:left;padding:11px 14px;color:var(--muted);font-size:.7rem;text-transform:uppercase;letter-spacing:.05em;border-bottom:1px solid var(--border);cursor:pointer;user-select:none;white-space:nowrap;background:var(--bg-soft)}
  thead th:hover{color:var(--accent)}
  thead th .ar{font-size:.66rem;margin-left:3px;opacity:.8}
  tbody td{padding:10px 14px;border-bottom:1px solid var(--border-soft);vertical-align:middle}
  tbody tr:last-child td{border-bottom:none}
  tbody tr:hover{background:var(--card-hover)}
  tr.model-row{cursor:pointer}
  .num{font-variant-numeric:tabular-nums;text-align:right}
  .m-name{font-weight:650}
  .m-id{color:var(--muted);font-size:.72rem;font-family:ui-monospace,monospace;margin-top:2px}
  a.m-link{color:var(--text)}
  a.m-link:hover{color:var(--accent);text-decoration:underline}
  .btn-ficha{background:var(--accent-soft);color:var(--accent);border:1px solid rgba(109,155,255,.35);border-radius:8px;padding:4px 10px;font-size:.72rem;font-weight:700;cursor:pointer;font-family:inherit;transition:all .15s;white-space:nowrap}
  .btn-ficha:hover{background:var(--accent);color:#fff}
  .yes{color:var(--green);font-weight:700}
  .no{color:#6b7b9e}

  /* ── Provider badges (identity) ── */
  .pb{display:inline-block;padding:2px 9px;border-radius:999px;font-size:.68rem;font-weight:700;margin:1px 2px 1px 0;white-space:nowrap;border:1px solid}
  .pb.go{color:var(--go);border-color:rgba(109,155,255,.35);background:rgba(109,155,255,.12)}
  .pb.zen{color:var(--zen);border-color:rgba(167,139,250,.35);background:rgba(167,139,250,.12)}
  .pb.or{color:var(--orange);border-color:rgba(251,146,60,.35);background:rgba(251,146,60,.12)}
  .pb.free{color:var(--green);border-color:rgba(52,211,153,.35);background:rgba(52,211,153,.12)}
  .pb.warn{color:var(--amber);border-color:rgba(251,191,36,.35);background:rgba(251,191,36,.12);cursor:help}
  .tier{display:inline-block;padding:1px 8px;border-radius:999px;font-size:.68rem;font-weight:600;border:1px solid var(--border);color:var(--muted);background:var(--bg-soft)}
  .tier.free{color:var(--green);border-color:rgba(52,211,153,.3)}

  /* ── Filters ── */
  .filters{display:flex;flex-wrap:wrap;gap:12px;align-items:flex-end;background:var(--card);border:1px solid var(--border);border-radius:var(--radius);padding:14px;margin-bottom:12px;box-shadow:var(--shadow)}
  .f-group{display:flex;flex-direction:column;gap:5px}
  .f-group label{font-size:.66rem;color:var(--muted);text-transform:uppercase;letter-spacing:.06em;font-weight:600}
  input[type=search],input[type=text],select{background:var(--bg-soft);border:1px solid var(--border);color:var(--text);border-radius:var(--radius-sm);padding:9px 12px;font-size:.9rem;font-family:inherit;transition:border-color .15s}
  input[type=search]:focus,select:focus{outline:none;border-color:var(--accent)}
  .checks{display:flex;gap:14px;flex-wrap:wrap;align-items:center}
  .checks label{display:flex;align-items:center;gap:7px;font-size:.84rem;cursor:pointer}
  .checks input{accent-color:var(--accent);width:16px;height:16px}

  /* ── Health ── */
  .hs-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:10px;margin-bottom:14px}
  .hs-card{background:var(--card);border:1px solid var(--border);border-radius:var(--radius);padding:12px 14px}
  .hs-card b{font-size:1.3rem;font-weight:800;display:block;line-height:1.15}
  .hs-card span{font-size:.72rem;color:var(--muted)}
  .hs-card.ok b{color:var(--green)} .hs-card.down b{color:var(--red)} .hs-card.na b{color:var(--muted)} .hs-card.free b{color:var(--green)}
  .hstatus{display:inline-flex;align-items:center;gap:5px;font-size:.8rem;font-weight:650;white-space:nowrap}
  .hstatus.hs-ok{color:var(--green)} .hstatus.hs-down{color:var(--red)} .hstatus.hs-unk{color:var(--amber)} .hstatus.hs-na{color:var(--muted)} .hstatus.hs-free{color:var(--green)}
  .hdot{width:9px;height:9px;border-radius:50%;display:inline-block;margin:0 1px}
  .hdot.ok{background:var(--green)} .hdot.down{background:var(--red)} .hdot.unk{background:var(--amber)}
  .hdot.na{background:transparent;border:1px solid #2a3040} .hdot.free{background:var(--green);opacity:.4}
  .fails-badge{display:inline-block;background:rgba(248,113,113,.15);color:var(--red);border:1px solid rgba(248,113,113,.3);font-size:.68rem;font-weight:700;padding:1px 7px;border-radius:999px}
  .dots{white-space:nowrap}

  /* ── Chain flow ── */
  .chain-flow{display:flex;flex-direction:column;gap:0;margin:14px 0}
  .chain-step{display:flex;gap:12px;align-items:stretch}
  .chain-pos{width:30px;height:30px;border-radius:50%;background:var(--accent-soft);border:1px solid var(--accent);color:var(--accent);font-weight:800;display:flex;align-items:center;justify-content:center;flex-shrink:0;font-size:.82rem}
  .chain-box{flex:1;background:var(--card);border:1px solid var(--border);border-radius:var(--radius-sm);padding:11px 14px}
  .chain-box .clink{font-family:ui-monospace,monospace;font-size:.82rem;color:var(--text);font-weight:600}
  .chain-box .crole{font-size:.76rem;color:var(--muted);margin-top:3px}
  .chain-arrow{display:flex;justify-content:center;color:var(--muted);font-size:.8rem;padding:2px 0 2px 15px}

  /* ── Quota bars ── */
  .quota-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:12px;margin-bottom:14px}
  .quota-cell{background:var(--bg-soft);border:1px solid var(--border-soft);border-radius:12px;padding:14px}
  .quota-name{font-size:.72rem;color:var(--muted);text-transform:uppercase;letter-spacing:.05em;font-weight:700}
  .quota-pct{font-size:1.6rem;font-weight:800;letter-spacing:-.02em;margin:4px 0}
  .quota-reset{font-size:.74rem;color:var(--muted)}
  .bar{height:8px;border-radius:999px;background:var(--border);overflow:hidden;margin-top:8px}
  .bar > i{display:block;height:100%;border-radius:999px}
  .bar > i.ok{background:var(--green)}
  .bar > i.warn{background:var(--amber)}
  .bar > i.down{background:var(--red)}

  .info-note{font-size:.74rem;color:var(--muted);margin-top:10px;line-height:1.6;background:var(--bg-soft);border:1px solid var(--border-soft);border-radius:10px;padding:10px 12px}
  .info-note b{color:var(--text)}
  .info-note code{font-family:ui-monospace,monospace;font-size:.74rem;color:var(--accent)}
  .oc-note{font-size:.76rem;color:var(--muted);margin:8px 0;line-height:1.6}
  .oc-note a{color:var(--accent)}

  /* ── Timeline (novedades) ── */
  .timeline{list-style:none;max-height:420px;overflow-y:auto;margin-top:8px}
  .timeline li{display:flex;align-items:baseline;gap:10px;padding:7px 2px;border-bottom:1px solid var(--border-soft);font-size:.82rem}
  .timeline li:last-child{border-bottom:none}
  .tl-date{color:var(--muted);font-size:.72rem;white-space:nowrap;min-width:74px}
  .tl-tag{font-size:.66rem;font-weight:700;padding:1px 8px;border-radius:999px;white-space:nowrap}
  .tl-tag.added{color:var(--green);background:rgba(52,211,153,.12);border:1px solid rgba(52,211,153,.3)}
  .tl-tag.removed{color:var(--red);background:rgba(248,113,113,.12);border:1px solid rgba(248,113,113,.3)}
  .tl-tag.manual{color:var(--zen);background:rgba(167,139,250,.12);border:1px solid rgba(167,139,250,.3)}
  .tl-tag.auto{color:var(--accent);background:rgba(109,155,255,.12);border:1px solid rgba(109,155,255,.3)}
  .tl-text{color:var(--text)}
  .tl-empty{color:var(--muted);font-size:.82rem;padding:14px 2px}

  /* ── Skeleton ── */
  .skel{display:none;padding:14px}
  .skel.on{display:block}
  .skel-row{height:46px;margin-bottom:8px;border-radius:var(--radius-sm);background:linear-gradient(90deg,var(--bg-soft) 25%,var(--card-hover) 50%,var(--bg-soft) 75%);background-size:200% 100%;animation:shimmer 1.3s infinite}
  @keyframes shimmer{to{background-position:-200% 0}}

  footer{margin-top:22px;color:var(--muted);font-size:.73rem;line-height:1.7}
  footer a{color:var(--accent)}

  /* ── Modal detalle ── */
  .md-overlay{position:fixed;inset:0;background:rgba(5,7,12,.72);z-index:100;display:flex;align-items:center;justify-content:center;padding:18px;backdrop-filter:blur(4px)}
  .md-overlay[hidden]{display:none}
  .md-panel{background:var(--card);border:1px solid var(--border);border-radius:18px;width:100%;max-width:680px;max-height:86vh;overflow-y:auto;padding:0;box-shadow:var(--shadow);outline:none}
  .md-head{position:sticky;top:0;background:rgba(21,25,38,.96);backdrop-filter:blur(10px);border-bottom:1px solid var(--border-soft);padding:14px 18px;display:flex;align-items:center;gap:12px;z-index:2}
  .md-head h2{font-size:1.05rem;font-weight:700;letter-spacing:-.01em;flex:1;min-width:0}
  .md-head .md-sub{font-size:.72rem;color:var(--muted);font-family:ui-monospace,monospace}
  .md-close{background:var(--bg-soft);border:1px solid var(--border);color:var(--muted);width:32px;height:32px;border-radius:9px;cursor:pointer;font-size:.95rem;flex-shrink:0;font-family:inherit}
  .md-close:hover{color:var(--text);border-color:var(--accent)}
  .md-body{padding:16px 18px 20px}
  .md-sec{margin-bottom:16px}
  .md-sec h3{font-size:.74rem;color:var(--muted);text-transform:uppercase;letter-spacing:.06em;margin-bottom:8px}
  .md-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(160px,1fr));gap:8px}
  .md-kv{background:var(--bg-soft);border:1px solid var(--border-soft);border-radius:10px;padding:8px 11px}
  .md-kv span{display:block;font-size:.64rem;color:var(--muted);text-transform:uppercase;letter-spacing:.05em}
  .md-kv b{font-size:.86rem;font-weight:650}
  .md-note{font-size:.78rem;color:var(--muted);line-height:1.6;margin-top:8px}
  .md-desc{font-size:.88rem;line-height:1.6}
  .md-badges{margin-bottom:10px}
  .md-status{display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin-bottom:8px}
  .md-dots{margin:6px 0}
  .md-foot{display:flex;gap:10px;margin-top:14px}
  .md-link{color:var(--accent);font-size:.8rem}
  .md-loading{color:var(--muted);font-size:.86rem;padding:20px 0;text-align:center}
  .var-chip{display:inline-block;background:var(--bg-soft);border:1px solid var(--border);font-size:.68rem;padding:1px 8px;border-radius:999px;color:var(--muted)}
  .verified-badge{font-size:.7rem;color:var(--muted);display:inline-block;margin:6px 0}
  .verified-badge.stale{color:var(--amber)}
  .lim-tbl{min-width:640px}
  .lim-tbl thead th{font-size:.66rem}
  .bench-grid{display:flex;flex-wrap:wrap;gap:6px}
  .bench-chip{background:var(--card);border:1px solid var(--border);border-radius:8px;padding:5px 11px;font-size:.76rem}
  .bench-chip b{color:var(--accent);font-weight:700;margin-left:6px;font-variant-numeric:tabular-nums}

  /* ── Bottom tab bar (mobile) ── */
  .bottomnav{display:none}
  @media (max-width:760px){
    .nav{display:none}
    .bottomnav{display:flex;position:fixed;bottom:0;left:0;right:0;z-index:60;background:rgba(11,13,19,.95);backdrop-filter:blur(14px);border-top:1px solid var(--border-soft);padding:6px 4px calc(6px + env(safe-area-inset-bottom));justify-content:space-around}
    .bottomnav button{flex:1;background:transparent;border:none;color:var(--muted);font-family:inherit;font-size:.62rem;font-weight:600;display:flex;flex-direction:column;align-items:center;gap:3px;padding:6px 2px;cursor:pointer;touch-action:manipulation}
    .bottomnav button .ico{font-size:1.15rem}
    .bottomnav button.active{color:var(--accent)}
    .kpi .kpi-val{font-size:1.45rem}
    /* Tablas → tarjetas apiladas (sin scroll horizontal) */
    .table-card{border:none;background:transparent;box-shadow:none;overflow:visible}
    .table-scroll{overflow:visible}
    table,thead,tbody,tr,td{display:block;width:100%}
    thead{display:none}
    table{min-width:0!important}
    tbody tr{background:var(--card);border:1px solid var(--border);border-radius:var(--radius);margin-bottom:8px;padding:6px 4px;box-shadow:var(--shadow)}
    tbody td{border:none;padding:3px 12px;display:flex;justify-content:space-between;align-items:center;min-height:26px;gap:14px}
    tbody td::before{content:attr(data-label);color:var(--muted);font-size:.66rem;text-transform:uppercase;letter-spacing:.05em;font-weight:600;flex-shrink:0}
    tbody td.num{text-align:right}
    td[data-label="Modelo"]{flex-direction:column;align-items:flex-start;border-bottom:1px solid var(--border-soft);margin-bottom:4px;padding-top:8px;padding-bottom:8px}
    td[data-label="Modelo"]::before{content:none}
    td[data-label="Historial (14 días)"]{flex-wrap:wrap;justify-content:space-between}
    td[data-label="Historial (14 días)"] .dots{white-space:normal}
    .f-group{width:100%}
    input[type=search],select{width:100%;min-height:44px}
    .checks{width:100%;gap:10px 18px}
  }
  @media (prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}
</style>
</head>
<body>

<!-- ── Topbar ── -->
<div class="topbar">
  <div class="topbar-in">
    <div class="brand">
      <div class="logo">🗂️</div>
      <div>
        <h1>Model Catalog</h1>
        <div class="sub">OpenCode Zen · Go · OpenRouter</div>
      </div>
    </div>
    <div class="topbar-spacer"></div>
    <div class="updated">Actualizado: <b id="updated">—</b></div>
  </div>
  <nav class="nav" id="nav" aria-label="Secciones">
    <button data-tab="resumen" class="active">📊 Resumen</button>
    <button data-tab="catalogo">🔍 Buscar</button>
    <button data-tab="salud">🩺 Disponibilidad</button>
    <button data-tab="precios">💱 Precios</button>
    <button data-tab="cadena">🔗 Cadena</button>
    <button data-tab="cuotas">🔔 Cuota Go</button>
    <button data-tab="evo">📈 Novedades</button>
  </nav>
</div>

<div class="wrap">

  <!-- ═══ RESUMEN ═══ -->
