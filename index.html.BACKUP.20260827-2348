const mdOverlay = document.getElementById('md-overlay');
const mdPanel = document.getElementById('md-panel');
const mdTitle = document.getElementById('md-title');
const mdSubId = document.getElementById('md-subid');
const mdBodyEl = document.getElementById('md-body');
let mdOpenId = null;
let mdLastFocus = null;
let mdScrollY = 0;
let mdPushedHash = false;

function mdParseHash() {
  const m = /^#\/model\/(.+)$/.exec(location.hash || '');
  if (!m) return null;
  try { return decodeURIComponent(m[1]); } catch (e) { return m[1]; }
}
function mdNavigate(id) {
  const target = '#/model/' + encodeURIComponent(id);
  if (location.hash === target) { mdRoute(); return; }
  mdPushedHash = true;
  location.hash = target;
}
function mdCloseRequest() {
  if (!mdParseHash()) { mdClose(); return; }
  if (mdPushedHash) { history.back(); return; }
  mdClose();
  try { history.replaceState(null, '', location.pathname + location.search); } catch (e) { location.hash = ''; }
}
function mdRoute() {
  const id = mdParseHash();
  if (id) mdOpen(id);
  else { mdPushedHash = false; mdClose(); }
}
function mdOpen(id) {
  const wasClosed = mdOpenId === null;
  if (wasClosed) {
    mdLastFocus = document.activeElement;
    mdScrollY = window.scrollY || window.pageYOffset || 0;
  }
  mdOpenId = id;
  mdRenderDetail(id);
  mdOverlay.hidden = false;
  document.body.classList.add('md-open');
  if (wasClosed) mdPanel.focus({ preventScroll: true });
  else mdPanel.scrollTop = 0;
  mdBodyEl.scrollTop = 0;
}
function mdClose() {
  if (mdOpenId === null) return;
  const closedId = mdOpenId;
  mdOpenId = null;
  mdOverlay.hidden = true;
  document.body.classList.remove('md-open');
  const f = mdLastFocus;
  mdLastFocus = null;
  window.scrollTo({ top: mdScrollY, behavior: 'auto' });
  let dest = (f && f !== document.body && document.contains(f) && typeof f.focus === 'function') ? f : null;
  if (!dest) {
    dest = document.querySelector('tr.model-row[data-id="' + (window.CSS && CSS.escape ? CSS.escape(closedId) : closedId) + '"] a.m-link');
  }
  if (dest) dest.focus({ preventScroll: true });
  else if (mdPanel.contains(document.activeElement)) {
    if (document.activeElement.blur) document.activeElement.blur();
  }
}
