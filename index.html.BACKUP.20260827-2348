  el.innerHTML = h;
}

async function fetchJSON(url, fallback) {
  try {
    const r = await fetch(url, { cache: 'no-cache' });
    if (!r.ok) throw new Error('HTTP ' + r.status);
    return await r.json();
  } catch (e) {
    return fallback;
  }
}

async function loadOC() {
  const [status, hist, catalog, limits, chAuto, chManual] = await Promise.all([
    fetchJSON('status.json', null),
    fetchJSON('status_history.json', { days: {} }),
    fetchJSON('catalog-history.json', { days: {}, events: [] }),
    fetchJSON('limits.json', null),
    fetchJSON('changelog-auto.json', { events: [] }),
    fetchJSON('changelog-manual.json', { events: [] }),
  ]);
  ST.status = status; ST.hist = hist; ST.catalog = catalog;
  ST.limits = limits; ST.chAuto = chAuto; ST.chManual = chManual;
  renderHealth(); renderLimits(); renderHistory(); renderChanges();
  renderSummary();
}

