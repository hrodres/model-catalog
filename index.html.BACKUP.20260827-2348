<script>
'use strict';
let DATA = null;
let sortKey = 'name', sortDir = 1;
let catSort = { k: 'name', d: 1 };

/* ───────── Helpers ───────── */
const $ = s => document.querySelector(s);
const esc = s => String(s == null ? '' : s).replace(/&/g, '&amp;').replace(/</g, '&lt;')
  .replace(/>/g, '&gt;').replace(/"/g, '&quot;');

function fmtCtx(n) {
  if (!n) return '<span class="no">—</span>';
  if (n >= 1000000) return (n / 1000000).toFixed(0) + 'M';
  if (n >= 1000) return Math.round(n / 1000) + 'K';
  return n;
}
function money(n) {
  if (n == null) return '—';
  return '$' + parseFloat(n).toFixed(n < 1 ? 3 : 2);
}
function moneyTag(n) {
  return n == null ? '<span class="no">—</span>' : '<b>' + money(n) + '</b>';
}
function cell(v) {
  if (v === true) return '<span class="yes">✓</span>';
  if (v === false) return '<span class="no">✗</span>';
  return '<span class="no">?</span>';
}
function sema(cls) { return '<span class="sema ' + cls + '"></span>'; }
function timeAgo(iso) {
  if (!iso) return '—';
  const d = new Date(iso); if (isNaN(d)) return '—';
  const ms = Date.now() - d.getTime();
  const h = Math.floor(ms / 3600000); const m = Math.floor(ms / 60000) % 60;
  if (h >= 24) { const days = Math.floor(h / 24); return 'hace ' + days + ' d' + (h % 24 ? ' ' + (h % 24) + 'h' : ''); }
  if (h > 0) return 'hace ' + h + 'h' + (m ? ' ' + m + 'm' : '');
  return 'hace ' + Math.max(1, m) + ' min';
}

function provBadges(m) {
  const b = [];
  if (m.providers.free) b.push('<span class="pb free">🌱 free</span>');
  if (m.providers.go) b.push('<span class="pb go">🚀 Go</span>');
  if (m.providers.or) b.push('<span class="pb or">🟠 OR</span>');
  if (m.providers.zen && !m.providers.free) b.push('<span class="pb zen">💜 Zen</span>');
  if (!m.md_url) b.push('<span class="pb warn" title="Solo en el catálogo opencode — sin ficha en models.dev">⚠️ sin ficha</span>');
  return b.join(' ');
}

function benchHTML(m) {
  const bk = m.benchmarks || {};
  const names = Object.keys(bk);
  if (!names.length) return '<span class="no">Sin benchmarks en models.dev</span>';
  return '<div class="bench-grid">' + names.map(n =>
    '<span class="bench-chip">' + esc(n) + '<b>' + esc(bk[n]) + '</b></span>'
  ).join('') + '</div>';
}

const GLOSSARY = [
  { t: 'Go (suscripción)', d: 'Pagas $10/mes y usas todos los modelos Go sin coste extra por token. Ideal para uso constante.' },
  { t: 'Zen / OpenRouter (por token)', d: 'Pagas según lo que consumes: $ por millón de tokens (MTok). Más barato si usas poco.' },
  { t: 'offpeak / peak', d: 'Zen cobra menos fuera de hora punta (offpeak) y más en hora punta (peak). En Precios verás ambos.' },
  { t: 'eslabón (cadena)', d: 'Cada paso de la cadena de respaldo. Si el proveedor principal falla, el sistema prueba el siguiente automáticamente.' },
  { t: 'cuota por buckets', d: 'Go limita el uso en 3 ventanas: continuo (rolling, pocas horas), semanal y mensual. El % es lo ya gastado.' },
  { t: 'SWE-Bench', d: 'Benchmark que mide cuánto sabe resolver tareas de ingeniería de software (0–100). Más alto = mejor.' },
  { t: 'contexto / output', d: 'Contexto: tokens máximos que el modelo "recuerda" en una conversación. Output: tokens máximos que puede generar de una vez.' },
  { t: 'free (gratis)', d: 'Modelos zen free. No se comprueban uno a uno porque comparten una cuota global.' },
  { t: 'Disponibilidad / probes', d: 'Los números de Disponibilidad son comprobaciones (probes): un mismo modelo en 3 proveedores cuenta 3 veces.' }
];
$('#g-body').innerHTML = GLOSSARY.map(g =>
  '<div class="g-item"><b>' + esc(g.t) + '</b><span>' + esc(g.d) + '</span></div>'
).join('');

/* ───────── Render catálogo (Buscar) ───────── */
function render() {
  if (!DATA) return;
  const prov = $('#f-provider').value;
  const q = $('#f-search').value.trim().toLowerCase();
  const needReason = $('#f-reason').checked;
  const needTool = $('#f-tool').checked;
  const needBench = $('#f-bench').checked;

  let rows = DATA.models.filter(m => {
    if (prov === 'free' && m.tier !== 'free') return false;
    if (prov === 'go' && !m.providers.go) return false;
    if (prov === 'zen' && !(m.providers.zen && !m.providers.free)) return false;
    if (prov === 'zenall' && !m.providers.zen) return false;
    if (prov === 'or' && !m.providers.or) return false;
    if (q && !(m.name.toLowerCase().includes(q) || m.id.toLowerCase().includes(q))) return false;
    if (needReason && m.reasoning !== true) return false;
    if (needTool && m.tool_call !== true) return false;
    if (needBench && !Object.keys(m.benchmarks || {}).length) return false;
    return true;
  });

  const k = catSort.k, d = catSort.d;
  const val = m => {
    if (k === 'name') return m.name.toLowerCase();
    if (k === 'prov') return (m.providers.go ? 1 : 0) + (m.providers.zen ? 1 : 0) + (m.providers.or ? 1 : 0);
    if (k === 'context') return m.context != null ? m.context : null;
    if (k === 'output') return m.output != null ? m.output : null;
    if (k === 'swe') return m.swebench != null ? m.swebench : null;
    if (k === 'orin') return m.or_price ? m.or_price.in : null;
    if (k === 'reasoning') return m.reasoning ? 1 : 0;
    if (k === 'tool') return m.tool_call ? 1 : 0;
    return null;
  };
  rows.sort((a, b) => {
    const va = val(a), vb = val(b);
    if (va == null && vb == null) return 0;
    if (va == null) return 1;
    if (vb == null) return -1;
    if (typeof va === 'number' && typeof vb === 'number') return (va - vb) * d;
    return String(va).localeCompare(String(vb)) * d;
  });

  const tbody = $('#tbody');
  tbody.innerHTML = rows.map(m => {
    const link = m.md_url
      ? '<a class="md-link" href="' + esc(m.md_url) + '" target="_blank" rel="noopener">↗ models.dev</a>'
      : '<span class="no">—</span>';
    let displayName = esc(m.name);
    if (m.providers.free && !/\(free\)/i.test(m.name)) displayName += ' <span class="pb free">free</span>';
    const fichaBtn = '<button type="button" class="btn-ficha" data-open="' + esc(m.id) + '" aria-label="Ver ficha de ' + esc(m.name) + '">📄 ficha</button>';
    return '<tr class="model-row" data-id="' + esc(m.id) + '" tabindex="0" role="button" aria-label="Ver ficha de ' + esc(m.name) + '">' +
      '<td data-label="Modelo"><div class="m-name"><a class="m-link" href="#/model/' + encodeURIComponent(m.id) + '" title="Ver ficha completa">' + displayName + '</a></div><div class="m-id">' + esc(m.id) + '</div></td>' +
      '<td data-label="Disponible en">' + provBadges(m) + '</td>' +
      '<td data-label="Contexto" class="num">' + fmtCtx(m.context) + '</td>' +
      '<td data-label="Output" class="num">' + fmtCtx(m.output) + '</td>' +
      '<td data-label="Reasoning" class="num">' + cell(m.reasoning) + '</td>' +
      '<td data-label="Tools" class="num">' + cell(m.tool_call) + '</td>' +
      '<td data-label="SWE-Bench" class="num">' + (m.swebench != null ? '<b>' + esc(m.swebench) + '</b>' : '<span class="no">—</span>') + '</td>' +
      '<td data-label="OR $/1M in" class="num">' + moneyTag(m.or_price ? m.or_price.in : null) + '</td>' +
      '<td data-label="Ficha">' + fichaBtn + ' ' + link + '</td>' +
      '</tr>';
  }).join('');

  const nFree = rows.filter(r => r.tier === 'free').length;
  const nGo = rows.filter(r => r.providers.go).length;
  const nZen = rows.filter(r => r.providers.zen).length;
  const nOr = rows.filter(r => r.providers.or).length;
  $('#count-pill').innerHTML = '📄 <b>' + rows.length + '</b> de ' + DATA.counts.total +
    ' modelos · 🌱 ' + nFree + ' · 🚀 ' + nGo + ' · 💜 ' + nZen + ' · 🟠 ' + nOr +
    (DATA.counts.with_modelsdev ? ' (📄 ' + DATA.counts.with_modelsdev + ' con ficha models.dev)' : '');
}

/* Ordenación por cabeceras (catálogo) */
function bindSort() {
  document.querySelectorAll('#tbl-cat thead th[data-k]').forEach(th => {
    th.addEventListener('click', () => {
      const k = th.dataset.k;
      if (catSort.k === k) { catSort.d *= -1; } else { catSort.k = k; catSort.d = 1; }
      document.querySelectorAll('#tbl-cat thead th .ar').forEach(a => a.textContent = '');
      th.querySelector('.ar').textContent = catSort.d === 1 ? '▲' : '▼';
      render();
    });
  });
}

/* ───────── Resumen (KPIs + proveedores) ───────── */
function renderSummary() {
  if (!DATA) return;
  const c = DATA.counts || {};
  $('#kpi-total').textContent = c.total || '—';
  $('#kpi-total-foot').textContent = 'Zen ' + (c.zen || 0) + ' · Go ' + (c.go || 0) + ' · OpenRouter ' + (c.openrouter || 0);
  $('#kpi-cheap-foot').textContent = c.cheapest_label || '—';

  const gq = (DATA.status_badges && DATA.status_badges.go_quota) || {};
  const mb = (gq.buckets && gq.buckets.monthly) || {};
  $('#kpi-quota').textContent = (mb.percent != null ? mb.percent : '?') + '%';
  if (mb.status) {
    $('#kpi-quota-sema').className = 'sema ' + (mb.status === 'ok' ? 'ok' : mb.status === 'warn' ? 'warn' : 'down');
  }
  $('#kpi-quota-reset').textContent = mb.resets_in_human || '—';

  const pr = (DATA.status_badges && DATA.status_badges.providers) || {};
  const stats = DATA.status_badges ? DATA.status_badges.providers : null;
  const grid = $('#prov-grid');
  const mk = [
    { key: 'opencode-go', cls: 'go', label: 'OpenCode Go', models: c.go || 0,
      note: 'Suscripción $10/mes · coste marginal 0. 429 = cuota, no caída.' },
    { key: 'opencode-zen', cls: 'zen', label: 'OpenCode Zen', models: c.zen || 0,
      note: 'Créditos + free (pool común). Free no se prueba (cuota global).' },
    { key: 'openrouter', cls: 'or', label: 'OpenRouter', models: c.openrouter || 0,
      note: 'Backend 100% independiente, más barato. Precios reales de API.' }
  ];
  grid.innerHTML = mk.map(p => {
    const probed = (stats && stats[p.key] && stats[p.key].probed) || {};
    const ok = probed.ok || 0; const down = probed.down || 0;
    const free = probed.free || 0; const na = probed.na || 0; const unk = probed.unk || 0;
    let status = 'ok', stxt = 'Operativo';
    if (down > 0) { status = 'warn'; stxt = down + ' caído' + (down > 1 ? 's' : ''); }
    if (down >= Math.max(1, Math.round(p.models * 0.3))) { status = 'down'; stxt = 'Varios caídos'; }
    const extra = [];
    if (na) extra.push('<b>' + na + '</b> no accesibles');
    if (unk) extra.push('<b>' + unk + '</b> no responden');
    if (free) extra.push('<b>' + free + '</b> free');
    return '<div class="prov ' + p.cls + '">' +
      '<div class="prov-head"><span class="sema ' + status + '"></span>' +
      '<span class="pname">' + esc(p.label) + '</span>' +
      '<span class="ptag">' + p.models + ' modelos</span></div>' +
      '<div class="prov-stats">' +
      '<div><b>' + ok + '</b> operativos</div>' +
      '<div><b>' + down + '</b> caídos</div>' +
      extra.map(e => '<div>' + e + '</div>').join('') +
      '</div>' +
      '<div class="prov-note">' + esc(p.note) + '</div></div>';
  }).join('');
}

/* ───────── Precios (matriz) ───────── */
function renderPrices() {
  const el = $('#prices-body');
  if (!DATA || !DATA.price_matrix) {
    el.innerHTML = '<div class="oc-note">Matriz de precios no disponible.</div>';
    return;
  }
  const P = DATA.price_matrix;
  let h = '<div class="info-note" style="margin-top:0">💱 Fuente: ' +
    esc(P.sources ? (P.sources.zen_paid + ' · ' + P.sources.openrouter) : 'ver plan') +
    ' · refresco ' + esc((P.fetched || '').replace('T', ' ').slice(0, 16)) +
    ' · moneda ' + esc(P.currency || 'USD') + '</div>';

  // Tabla comparativa unificada: por modelo del catálogo (in $/1M)
  h += '<div class="table-card" style="margin-top:10px"><div class="table-scroll">' +
    '<table id="tbl-price"><thead><tr>' +
    '<th data-k="name">Modelo<span class="ar"></span></th>' +
    '<th>Go</th>' +
    '<th data-k="zenin" class="num">Zen in (off→peak)<span class="ar"></span></th>' +
    '<th data-k="orin" class="num">OpenRouter in/out<span class="ar"></span></th>' +
    '<th data-k="ctx" class="num">Contexto<span class="ar"></span></th>' +
    '</tr></thead><tbody id="tbody-price"></tbody></table></div></div>';

  const zenP = P.zen_paid_offpeak || {};
  const zenPeak = P.zen_paid_peak || {};
  const orP = P.openrouter || {};

  const orIds = (DATA.models || []).filter(m => m.or_id).map(m => m.or_id);
  const seen = {};
  orIds.forEach(id => { if (!seen[id]) { seen[id] = 1; } });

  const rows = (DATA.models || []).map(m => {
    const zp = zenP[m.id];
    const or = m.or_price || (m.or_id && orP[m.or_id]) || null;
    const zen = zp
      ? money(zp.in) + ' → ' + money((zenPeak[m.id] || {}).in)
      : '<span class="no">—</span>';
    const go = m.providers.go ? '<span class="tier">plan $10/mes</span>' : '<span class="no">—</span>';
    const orv = or ? money(or.in) + ' / ' + money(or.out) : '<span class="no">—</span>';
    return { m, name: m.name.toLowerCase(), id: m.id, zenhtml: zen, gohtml: go, orhtml: orv, orin: or ? or.in : null, ctx: m.context || null };
  });

  h += '<div class="info-note">🔒 ' + esc(P.notes || 'Sin saldos ni claves. Solo precios públicos por millón de tokens (MTok).') + '</div>';
  el.innerHTML = h;

  let priceSort = { k: 'name', d: 1 };
  const sortPrice = () => {
    const d = priceSort.d, k = priceSort.k;
    const val = r => {
      if (k === 'name') return r.name;
      if (k === 'zenin') { const p = zenP[r.id]; return p ? p.in : null; }
      if (k === 'orin') return r.orin;
      if (k === 'ctx') return r.ctx;
      return null;
    };
    const sorted = rows.slice().sort((a, b) => {
      const va = val(a), vb = val(b);
      if (va == null && vb == null) return 0;
      if (va == null) return 1;
      if (vb == null) return -1;
      if (typeof va === 'number' && typeof vb === 'number') return (va - vb) * d;
      return String(va).localeCompare(String(vb)) * d;
    });
    $('#tbody-price').innerHTML = sorted.map(r =>
      '<tr><td data-label="Modelo"><div class="m-name">' + esc(r.m.name) + '</div><div class="m-id">' + esc(r.id) + '</div></td>' +
      '<td data-label="Go">' + r.gohtml + '</td><td data-label="Zen in (off→peak)" class="num">' + r.zenhtml + '</td>' +
      '<td data-label="OpenRouter in/out" class="num">' + r.orhtml + '</td><td data-label="Contexto" class="num">' + fmtCtx(r.ctx) + '</td></tr>'
    ).join('');
  };
  document.querySelectorAll('#tbl-price thead th[data-k]').forEach(th => {
    th.addEventListener('click', () => {
      const k = th.dataset.k;
      if (priceSort.k === k) { priceSort.d *= -1; } else { priceSort.k = k; priceSort.d = 1; }
      document.querySelectorAll('#tbl-price thead th .ar').forEach(a => a.textContent = '');
      th.querySelector('.ar').textContent = priceSort.d === 1 ? '▲' : '▼';
      sortPrice();
    });
  });
  sortPrice();
}

