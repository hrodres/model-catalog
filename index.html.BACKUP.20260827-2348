  h += '<div class="md-foot">' +
    (m.md_url
      ? '<a class="md-link" href="' + esc(m.md_url) + '" target="_blank" rel="noopener">↗ Ver en models.dev</a>'
      : '<span class="md-note">Sin ficha en models.dev (solo catálogo opencode)</span>') +
    '</div>';
  mdBodyEl.innerHTML = h;
}

/* ───────── Tabs ───────── */
function activate(tab) {
  document.querySelectorAll('.panel').forEach(p => p.classList.remove('active'));
  document.querySelectorAll('#nav button, #bottomnav button').forEach(b => b.classList.toggle('active', b.dataset.tab === tab));
  const panel = $('#p-' + tab);
  if (panel) panel.classList.add('active');
  window.scrollTo({ top: 0, behavior: 'smooth' });
}
document.querySelectorAll('#nav button, #bottomnav button').forEach(b => {
  b.addEventListener('click', () => activate(b.dataset.tab));
});

/* ───────── Eventos ───────── */
['#f-provider', '#f-search', '#f-reason', '#f-tool', '#f-bench'].forEach(s => $(s).addEventListener('input', render));
bindSort();

$('#tbody').addEventListener('click', e => {
  if (e.target.closest('a')) return;
  const tr = e.target.closest('tr.model-row');
  if (tr) mdNavigate(tr.dataset.id);
});
$('#tbody').addEventListener('keydown', e => {
  if (e.key === 'Enter' || e.key === ' ') {
    const tr = e.target.closest('tr.model-row');
    if (tr) { e.preventDefault(); mdNavigate(tr.dataset.id); }
  }
});
document.getElementById('md-close').addEventListener('click', mdCloseRequest);
document.getElementById('md-overlay').addEventListener('click', e => { if (e.target === mdOverlay) mdCloseRequest(); });
document.addEventListener('keydown', e => {
  if (mdOpenId === null) return;
  if (e.key === 'Escape') { e.preventDefault(); mdCloseRequest(); return; }
  if (e.key === 'Tab') {
    const f = mdPanel.querySelectorAll('button, [href], input, select, textarea, [tabindex]:not([tabindex="-1"])');
    const list = Array.prototype.filter.call(f, el => el.offsetParent !== null || el === mdPanel);
    if (!list.length) return;
    const first = list[0], last = list[list.length - 1];
    if (e.shiftKey && (document.activeElement === first || document.activeElement === mdPanel)) {
      e.preventDefault(); last.focus();
    } else if (!e.shiftKey && document.activeElement === last) {
      e.preventDefault(); first.focus();
    }
  }
});
window.addEventListener('hashchange', mdRoute);
mdRoute();
loadOC();

/* ───────── Carga de data.json ───────── */
fetch('data.json', { cache: 'no-cache' }).then(r => {
  if (!r.ok) throw new Error('HTTP ' + r.status);
  return r.json();
}).then(d => {
  DATA = d;
  document.getElementById('skel').classList.remove('on');
  $('#updated').textContent = timeAgo(d.generated);
  $('#gen').textContent = 'Generado: ' + (d.generated || '').replace('T', ' ').slice(0, 16) +
    ' · models.dev: ' + (d.modelsdev_fetched || '—') + ' (' + (d.modelsdev_count || '?') + ' modelos)';
  // Precio más barato (OpenRouter in)
  const cheapest = d.models.filter(m => m.or_price).sort((a, b) => a.or_price.in - b.or_price.in)[0];
  $('#kpi-cheap').textContent = cheapest ? money(cheapest.or_price.in) + '/1M' : '—';
  $('#kpi-cheap-foot').textContent = cheapest ? cheapest.name + ' (OpenRouter)' : '—';
  // Resumen salud (status_badges)
  const gq = (d.status_badges && d.status_badges.go_quota) || {};
  const pr = (d.status_badges && d.status_badges.providers) || {};
  const goP = pr['opencode-go'] && pr['opencode-go'].probed ? (pr['opencode-go'].probed.down || 0) : 0;
  $('#kpi-health').textContent = goP > 0 ? '⚠️ ' + goP + ' caídos' : '🟢 Saludable';
  $('#kpi-health-sema').className = 'sema ' + (goP > 0 ? 'warn' : 'ok');
  $('#kpi-health-foot').textContent = (goP > 0 ? goP + ' de ' : '') + (d.counts ? d.counts.go : '?') + ' modelos Go con problemas' + (gq.badge ? ' · ' + gq.badge : '');
  render();
  renderSummary();
  renderPrices(); renderChain(); renderQuota();
  if (mdOpenId) mdRenderDetail(mdOpenId);
}).catch(e => {
  document.getElementById('skel').classList.remove('on');
  $('#tbody').innerHTML = '<tr><td colspan="9">Error cargando data.json: ' + esc(e.message) + '</td></tr>';
  $('#updated').textContent = 'error';
});
</script>
</body>
</html>